# Contact + estimate form email delivery via EmailJS (https://www.emailjs.com)
# See src/lib/email.ts for the template setup.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxx
# Optional; defaults to fullmersgrind@yahoo.com. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=fullmersgrind@yahoo.com
