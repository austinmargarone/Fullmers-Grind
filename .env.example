# Contact + estimate form email delivery (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend (add the DNS records Resend gives you for fullmersgrind.com)
CONTACT_FROM_EMAIL="Fullmers Grind Website <website@fullmersgrind.com>"
# Optional; defaults to fullmersgrind@yahoo.com. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=fullmersgrind@yahoo.com
